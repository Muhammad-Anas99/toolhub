# Copy this file to .env and fill in real values. Never commit .env itself.

# development | production
NODE_ENV=development

PORT=5000

# MongoDB Atlas connection string. Example:
# mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/toolhub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/toolhub

# The frontend's origin, for CORS. Vite's default dev server port is 5173.
CLIENT_URL=http://localhost:5173

# Rate limiting (applied to all /api routes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File uploads
# Note: Vercel's Hobby plan caps request bodies at 4.5MB regardless of this
# setting. Keep this at or below 4.5 if deploying to Vercel on a free plan,
# or upgrade to Pro for a higher limit.
UPLOAD_MAX_FILE_SIZE_MB=4
UPLOAD_DIR=uploads

# Only needed if deploying to Vercel: enable Vercel Blob storage on your
# project (Storage tab in the dashboard) and it sets this automatically —
# you don't need to fill it in by hand for a Vercel deployment. Without it,
# uploads fall back to writing to UPLOAD_DIR on local disk, which is fine
# for local development but won't work once deployed to Vercel (its
# filesystem is read-only/ephemeral in production).
BLOB_READ_WRITE_TOKEN=

# --- Authentication (Phase 5) -----------------------------------------------

# Two DIFFERENT secrets, on purpose — if an access token ever leaks, an
# attacker still can't forge a refresh token with it, and vice versa.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt cost factor. 10-12 is the standard range; higher is slower but
# more resistant to brute-forcing a stolen password hash.
BCRYPT_SALT_ROUNDS=12

# --- Email (verification, password reset, welcome, and security alert emails) --
# If left blank, emails are logged to the server console instead of actually
# sent — fine for local development, NOT fine for production.
#
# Configured here for Brevo (https://www.brevo.com), but SMTP_HOST/PORT
# work with any standard SMTP provider (SendGrid, Mailgun, Resend, etc.) —
# just swap the values below.
#
# Brevo setup: Brevo dashboard -> Settings -> SMTP & API -> SMTP tab.
# SMTP_USER is your Brevo account login email. SMTP_PASS is the generated
# SMTP key shown there — NOT your regular Brevo account password.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender identity for every outgoing email. Must be a verified sender in
# your Brevo account (Senders, Domains & Dedicated IPs -> Senders) or
# Brevo will reject the send. Accepts "Name <email>" format directly.
EMAIL_FROM=ToolHub <noreply@yourdomain.com>

# --- One-time admin account creation (npm run seed:admin) -------------------
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@toolhub.example.com
ADMIN_PASSWORD=ChangeThisImmediately123!

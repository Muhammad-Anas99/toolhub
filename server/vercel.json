{
  "version": 2,
  "buildCommand": null,
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/downloads/cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
